# /etc/sudoers.d/zabbix-openzfs
Defaults:zabbix !requiretty
zabbix ALL=(root) NOPASSWD: /usr/sbin/zpool list -Hp -o name\,guid\,size\,alloc\,free\,cap\,frag\,health --json
zabbix ALL=(root) NOPASSWD: /usr/sbin/zpool status -j --json-flat-vdevs --json-int
zabbix ALL=(root) NOPASSWD: /usr/sbin/zfs list -jp -t filesystem\,volume -o name\,type\,used\,available\,referenced\,compressratio\,quota\,refquota\,usedbysnapshots
zabbix ALL=(root) NOPASSWD: /usr/sbin/zpool iostat -Hpv 1 2
